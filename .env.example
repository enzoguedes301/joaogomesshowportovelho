# Copie este arquivo para .env e preencha. O .env não vai para o git.

# PIXGO_API_KEY: chave da API PixGo (https://pixgo.org → dashboard → Checkouts).
# Fica só no servidor; o navegador nunca a recebe.
PIXGO_API_KEY="pk_sua_chave_aqui"

# PIXGO_WEBHOOK_SECRET: segredo do webhook, na mesma página da chave.
# Sem ele o servidor aceita o webhook mas não confere a assinatura — em produção, preencha.
PIXGO_WEBHOOK_SECRET="whsec_seu_segredo_aqui"

# PIXGO_WEBHOOK_URL: endereço PÚBLICO que a PixGo chama quando o pagamento cai.
# Aponte para /api/pix/webhook desta aplicação. Em desenvolvimento, use um túnel
# (ngrok, cloudflared) — localhost não é alcançável de fora.
# Sem isso o pagamento ainda é detectado, só que por consulta periódica, não na hora.
PIXGO_WEBHOOK_URL=""

# PORT: porta do servidor de produção (npm run build && npm start). Padrão 3100.
# Em hospedagem gerenciada, deixe a plataforma definir — ela injeta a própria.
PORT="3100"
